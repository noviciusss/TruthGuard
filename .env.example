# Copy to .env for local development. Never commit .env.

# Groq is the primary runtime provider for synthesis and bulk generation.
GROQ_API_KEY=

# Optional fallback / lineage-separated providers.
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Runtime behavior
TRUTHGUARD_CONFIG=config.yaml
TRUTHGUARD_OFFLINE=true
TRUTHGUARD_DATA_DIR=data
HF_HOME=.cache/huggingface
